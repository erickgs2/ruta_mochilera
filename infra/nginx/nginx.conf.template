# TLS termination lives here, in this Nginx, not in front of it: qa and
# production are a single EC2 instance with no load balancer in the spec
# (docs/superpowers/specs/2026-09-28-agencia-viajes-diseno.md, §11 -- "Un
# solo Nginx al frente, en la misma máquina"), so introducing an ALB/ELB just
# to hold a certificate would be new infrastructure the design never called
# for. Certificates come from Let's Encrypt via a certbot companion
# container (see `infra/compose/compose.prod.yml`), issued and renewed with
# the HTTP-01 challenge served out of the `/.well-known/acme-challenge/`
# location below.
#
# `${DOMAIN_NAME}` is substituted at container start by the official nginx
# image's own template mechanism (this file is copied to
# `/etc/nginx/templates/default.conf.template`; see `Dockerfile.web`), from
# the `DOMAIN_NAME` environment variable in `.env.prod`. Dev (Raspberry Pi)
# does not set it and does not run this Nginx image with TLS -- see the
# README's deployment section.

# Plain HTTP: only the ACME challenge is ever answered here. Everything else
# redirects to HTTPS so the refresh-token cookie's `Secure` attribute (see
# `apps/api/src/lib/http/refresh-cookie.ts`) is never silently dropped by a
# client that happened to connect over port 80.
server {
    listen 80;
    server_name ${DOMAIN_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN_NAME};
    client_max_body_size 10M;

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The API and both Angular apps live behind this single front door. The
    # `api` hostname is the compose service name from compose.prod.yml.
    location /api/ {
        proxy_pass http://api:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Each app is built with its own base href (`baseHref` in the production
    # configuration of apps/admin/project.json and apps/client/project.json),
    # so its scripts, styles, fonts and images resolve under its own prefix,
    # and each lives in the directory of the same name under this `root`
    # (see Dockerfile.web). `root` rather than `alias`: the nested caching
    # location below inherits `root`, which it would not do with `alias`.
    #
    # `try_files ... /<app>/index.html` hands every deep link (a reload on
    # /app/reservations/123) to Angular's router instead of a 404.
    #
    # Only files whose name carries Angular's content hash (`main-CQOSORMN.js`,
    # the self-hosted fonts under media/) are cached for a year: they never
    # change under the same name. The logo, favicons and translation
    # catalogues keep their names across deploys, so they get no long cache,
    # and index.html is revalidated on every load so a deploy is picked up at
    # once.
    root /usr/share/nginx/html;

    # Relative `Location` headers: a redirect never names a host or port, so
    # it is right behind any port mapping, not only on 443.
    absolute_redirect off;

    location = /admin {
        return 301 /admin/;
    }

    location /admin/ {
        try_files $uri $uri/ /admin/index.html;

        location ~* "-[A-Za-z0-9_]{8}\.(?:js|css|woff2?)$" {
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }

    location = /admin/index.html {
        add_header Cache-Control "no-cache";
    }

    location = /app {
        return 301 /app/;
    }

    location /app/ {
        try_files $uri $uri/ /app/index.html;

        location ~* "-[A-Za-z0-9_]{8}\.(?:js|css|woff2?)$" {
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
    }

    location = /app/index.html {
        add_header Cache-Control "no-cache";
    }

    # Customers far outnumber staff, so the bare domain opens the customer
    # app. The panel stays one path away at /admin/.
    location / {
        return 302 /app/;
    }
}
