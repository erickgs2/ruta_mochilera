# qa/production environment for infra/compose/compose.prod.yml.
#
# Copy to `.env.prod` at the repo root, fill in real secrets, and never commit
# that file. This is deliberately a separate file from `.env` (the developer's
# own machine): compose.prod.yml must not read a laptop's NODE_ENV, JWT_SECRET
# or local database credentials, so it takes neither `.env` nor its defaults.
#
# Run with:
#   docker compose -f infra/compose/compose.prod.yml --env-file .env.prod up -d --build
#
# DATABASE_URL below is overridden again inside compose.prod.yml to point at
# the `postgres` service by its compose hostname; it is listed here only so
# `docker compose config` has a value to validate against.
NODE_ENV=production
DATABASE_URL=postgresql://rm:CHANGE_ME@postgres:5432/rm_prod
POSTGRES_USER=rm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=rm_prod
JWT_SECRET=CHANGE_ME_TO_AT_LEAST_32_CHARACTERS_LONG
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
APP_BASE_URL=https://CHANGE_ME
# The client app's public base URL, path prefix included -- Nginx serves the
# client under /app. Links mailed to customers (e.g. password reset) are
# built from this, never from APP_BASE_URL (the API's origin).
CLIENT_APP_URL=https://CHANGE_ME/app
# The public hostname this environment answers on. Read by the `nginx`
# service's own container to render infra/nginx/nginx.conf.template (TLS
# server_name, Let's Encrypt cert path) and by the one-time `certbot
# certonly` command in compose.prod.yml's `certbot` service comment -- must
# match APP_BASE_URL's host and already resolve in DNS to this host before
# the first certificate request.
DOMAIN_NAME=CHANGE_ME
STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=CHANGE_ME
STORAGE_S3_REGION=CHANGE_ME

# Phase 2A: payments and transactional email. Fill with real values from the
# Stripe dashboard / Resend account; never commit the real values.
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_PUBLISHABLE_KEY=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_ADDRESS=no-reply@CHANGE_ME

# Social login providers. Deliberately left empty, not CHANGE_ME: empty means
# "provider disabled", which is how social login degrades gracefully while
# the Google/Apple developer accounts are not ready yet.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Task 15b: the packaged apps/client (Capacitor) build is cross-origin from
# this API no matter which domain APP_BASE_URL ends up being -- see
# apps/api/src/lib/http/cors.ts and task-15-report.md. These two origins are
# Capacitor's own defaults (iOS / Android) and do not depend on this
# environment's domain, so they are not a CHANGE_ME placeholder.
CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
