NODE_ENV=development
# Native PostgreSQL 15 on this machine (role and databases created locally).
DATABASE_URL=postgresql://rm:rm@localhost:5432/rm_dev
# Docker alternative (infra/compose/compose.dev.yml + compose.test.yml):
# the dev database is on port 5432 as above, but the test database is on
# port 5433 (postgresql://rm:rm@localhost:5433/rm_test). On this machine,
# rm_test is a separate native database that also lives on port 5432.
# Used only by the integration test helpers in `@rm/db/testing`.
TEST_DATABASE_URL=postgresql://rm:rm@localhost:5432/rm_test
JWT_SECRET=change-me-to-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
APP_BASE_URL=http://localhost:3000
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# Only with STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=
