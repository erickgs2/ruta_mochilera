# Local development only. qa/production (infra/compose/compose.prod.yml) reads
# a separate .env.prod, never this file -- see .env.prod.example.
NODE_ENV=development
# Native PostgreSQL 15 on this machine (role and databases created locally).
DATABASE_URL=postgresql://rm:rm@localhost:5432/rm_dev
# Docker alternative (infra/compose/compose.dev.yml + compose.test.yml):
# the dev database is on port 5432 as above, but the test database is on
# port 5433 (postgresql://rm:rm@localhost:5433/rm_test). On this machine,
# rm_test is a separate native database that also lives on port 5432.
# Used only by the integration test helpers in `@rm/db/testing`.
TEST_DATABASE_URL=postgresql://rm:rm@localhost:5432/rm_test
JWT_SECRET=change-me-to-at-least-32-characters-long
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
APP_BASE_URL=http://localhost:3000
# The client app's public base URL, path prefix included: links mailed to
# customers (e.g. password reset) open here, not on APP_BASE_URL (the API).
# `nx serve client` listens on 4201 (apps/client/project.json).
CLIENT_APP_URL=http://localhost:4201
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# Only with STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=
# STORAGE_S3_REGION=

# Phase 2A: payments and transactional email. Fill with real values from the
# Stripe dashboard / Resend account; never commit the real values.
STRIPE_SECRET_KEY=CHANGE_ME
STRIPE_WEBHOOK_SECRET=CHANGE_ME
STRIPE_PUBLISHABLE_KEY=CHANGE_ME
RESEND_API_KEY=CHANGE_ME
RESEND_FROM_ADDRESS=no-reply@CHANGE_ME
# Off by default, on purpose: Task 11 sends six-digit email-verification
# codes through this port, and turning this on prints the full html/text
# body (including those codes) to the console log. Only set to the literal
# string "true" when you genuinely need to see a body locally; any other
# value, including unset, stays off.
# EMAIL_VERBOSE_LOGGING=true

# Social login providers. Deliberately left empty, not CHANGE_ME: empty means
# "provider disabled", which is how social login degrades gracefully while
# the Google/Apple developer accounts are not ready yet.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_CLIENT_ID=

# Task 8: apps/worker (expireHolds, warnExpiringHolds, reconcilePaidCents,
# and the SEND_NOTIFICATION_EMAIL_JOB outbox handler) needs no variables of
# its own beyond the ones above -- it reuses DATABASE_URL for both Prisma and
# its own pg-boss queue (a separate schema, `pgboss`, alongside Prisma's
# `public`; see `libs/jobs/src/testing/test-queue.ts` for why the two must
# stay apart) and RESEND_API_KEY/RESEND_FROM_ADDRESS for the actual send.

# Task 15b: comma-separated exact origins allowed to call this API
# cross-origin with credentials -- see apps/api/src/lib/http/cors.ts. Empty
# by default: the admin panel and the web client are same-origin (via Nginx
# in production, via each app's own proxy.conf.json in development) and
# never trigger CORS at all. This exists only for the packaged apps/client
# (Capacitor) build, whose WebView origin is genuinely cross-origin from the
# API -- see task-15-report.md. The two default Capacitor origins:
# CORS_ALLOWED_ORIGINS=capacitor://localhost,https://localhost
